PORT=3000
# Use a long random secret. This is NOT a user login; it protects the private admin alert channel.
ADMIN_KEY=replace-with-a-long-random-secret

# Optional web-push notifications (needed to receive alerts when the admin page is closed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
